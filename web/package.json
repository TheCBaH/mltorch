{
  "name": "mltorch-viewer",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Stage 0A contract spike: drives the pinned Model Explorer visualizer to settle the questions the coordinator design assumes.",
  "scripts": {
    "install:chromium": "playwright install chromium --with-deps",
    "serve": "http-server src -p 8123 -c-1 --silent",
    "serve:webapp": "http-server ../webapp-dist -p 8124 -c-1 --silent",
    "spike": "playwright test",
    "webapp": "playwright test -c playwright.webapp.config.ts"
  },
  "engines": {
    "node": "20.19.2",
    "npm": "9.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "http-server": "^14.1.1"
  }
}

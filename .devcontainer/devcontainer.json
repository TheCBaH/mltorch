// For format details, see https://aka.ms/devcontainer.json.
{
    "name": "mltorch",
    "build":  {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/sshd:1": {},
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": "true",
            "username": "vscode",
            "userUid": "1000",
            "userGid": "1000",
            "upgradePackages": "false"
        },
        // melange and ppx_expect are pinned TOGETHER and must move together.
        // Not because melange lacks 4.14 support -- melange.7.0.1-414 exists and
        // installs fine -- but because melange 7 needs ppxlib >= 0.36, whose
        // parsetree change the Jane Street v0.16 ppx set cannot compile against,
        // and the ppx_inline_test that can needs OCaml >= 5.1. On this switch
        // opam has no solution for the pair and resolves it by dropping
        // ppx_expect, silently taking every inline test with it. 5.1.0-414 is
        // what the solver picks anyway.
        // fmt and jsont are pinned because js/melange/vendor copies their
        // sources and the jsont patch is checksum-guarded against 0.4.0.
        // bytesrw is pinned for plain reproducibility of the native build; 0.4.1 is
        // the first release whose Bytes.Writer.limit raises Stream.Error (not
        // Invalid_argument) when the budget lands exactly on a slice boundary.
        // cmdliner is pinned because its CLI error-message rendering (quoted
        // vs styled text, see Cmdliner_base.styler) is asserted verbatim in
        // test/me_visualize_json_cram.t; an unpinned bump silently broke that
        // golden once already.
        // err_trace and err_trace-melange are pinned to the upstream main branch
        // (not on opam yet), as the rivet devcontainer does; err_trace-melange
        // needs melange, so it is listed after it.
        // Deliberately floating: ctypes, ctypes-foreign, landmarks,
        // landmarks-ppx, memtrace, utop, yaml, zipc -- none is part of the JS
        // build or that solve. See .ai/js_backends_design.md.
        "ghcr.io/thecbah/ocaml-features/ocaml:1": {
            "version": "4.14.3",
            "packages": "bytesrw#0.4.1 cmdliner#2.1.1 ctypes ctypes-foreign fmt#0.11.0 js_of_ocaml#6.4.1 js_of_ocaml-compiler#6.4.1 js_of_ocaml-ppx#6.4.1 jsont#0.4.0 landmarks landmarks-ppx melange#5.1.0-414 err_trace#git+https://github.com/TheCBaH/err_trace#main err_trace-melange#git+https://github.com/TheCBaH/err_trace#main memtrace menhir ppx_expect#v0.16.2 utop yaml zarith zipc",
            "system-packages": "libgmp-dev pkg-config",
            // rivet and rivet_compcert are installed from source archives (no
            // submodules), at the revisions rivet-compcert's vendor/rivet pins
            // together; rivet_compcert builds the host ISA's embedding and
            // downloads the CompCert artifacts pinned in its compcert.lock.
            "pin-packages": "rivet https://github.com/TheCBaH/rivet/archive/0d6f744259e10c30d1920e086583b4d346afaee9.tar.gz,rivet_compcert https://github.com/TheCBaH/rivet-compcert/archive/fda3e66e627fd67267a3eacc57cf0c399c4f675c.tar.gz"
        },
        // Node/npm run the js_of_ocaml, melange and browser gates. Exact Debian
        // package pins keep a developer rebuild and CI on one runtime too.
        "./features/npm": {
            "node_version": "20.19.2+dfsg-1+deb13u3",
            "npm_version": "9.2.0~ds1-3"
        },
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ocamllabs.ocaml-platform"
            ]
        }
    },
    "remoteUser": "vscode",
    "postCreateCommand": {
        "submodules": "git submodule update --init --depth 1",
        "opam": "sudo sh -ceux \"chown -R $(id -u):$(id -g) ${OPAMROOT}/log\""
    },
    "waitFor": "postCreateCommand"
}

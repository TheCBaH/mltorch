; The peak kernels as a library, so the Rivet-only byte baseline and the RTL
; driver build the same modules.

(library
 (name peak_kernels)
 (wrapped false)
 (libraries coralnpu_kernels coralnpu_kernels_zvt)
 (enabled_if
  (and
   %{lib-available:rivet.riscv32_encode}
   %{lib-available:rivet.driver_direct})))

; The Rivet AArch64 engines on a small body: bitwise the direct evaluator's
; results on every mechanism and allocator, a distinct identity per word, and
; a check that a deviation is seen. Built wherever Rivet's AArch64 libraries
; are installed; they run on the CPU, so an AArch64 host is required.

(library
 (name inference_compare_rivet_test)
 (modules rivet_test)
 (libraries
  err_trace
  fmt
  inference_compare_generated_test
  inference_compare_pt2
  inference_compare_rivet
  native
  native_test)
 (inline_tests)
 (preprocess
  (pps ppx_expect))
 (enabled_if
  (and
   %{lib-available:rivet.aarch64_encode}
   %{lib-available:rivet.driver_direct})))

; Melange route for the tail-call conversion's Stage 5 correctness harness
; (see test/expr_bench/corpus.ml and .ai/). Links [expr_internal_mel]
; directly, not [expr_mel]/[expr]: [Eval_candidates] is internal, never
; exposed through the public [Expr] API. Same [expr_internal.ml] shim
; pattern as every other Expr_internal consumer mirror.

(copy_files
 (files
  %{workspace_root}/test/expr_bench/{corpus,expr_bench_run,cleanup_negative,order_check}.ml))

(melange.emit
 (target output)
 (alias expr-bench-melange)
 (module_systems commonjs)
 (enabled_if
  (= %{profile} melange))
 (modules corpus expr_bench_run cleanup_negative order_check expr_internal)
 (libraries expr_internal_mel))

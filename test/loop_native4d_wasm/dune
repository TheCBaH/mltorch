; Native4D graphs through the whole-model Wasm backend, run under node: each
; case's module is generated and run, and every output must equal
; [Eval_direct4.run] bitwise. The cases are the ones the C and JavaScript suites
; run (loop_native4d_common). Needs node, so it runs under `make wasm.runtest`
; (which sets MLTORCH_WASM), not plain `make runtest`; inside it a missing node
; is a failure, never a skip.

(library
 (name loop_native4d_wasm_test)
 (libraries
  core
  err_trace
  fmt
  loop_c_exec
  loop_ir
  loop_native4d
  loop_native4d_common
  loop_wasm_exec
  native
  native4d
  unix
  ssa_backends)
 (inline_tests
  (enabled_if
   (<> %{env:MLTORCH_WASM=} "")))
 (preprocess
  (pps ppx_expect)))

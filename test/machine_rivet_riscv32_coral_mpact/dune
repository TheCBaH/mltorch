(library
 (name machine_rivet_riscv32_coral_mpact_test)
 (libraries
  contraction
  coralnpu
  coralnpu_kernels
  coralnpu_kernels_zvt
  fmt
  machine_model
  machine_model_test
  machine_rivet_riscv32
  machine_rivet_riscv32_coral
  machine_rivet_riscv32_mir
  rivet.image
  ssa_backends
  ssa_ir)
 (inline_tests
  (deps
   (env_var CORALNPU_DATA)
   (env_var CORALNPU_RUN_DEADLINE)))
 (preprocess
  (pps ppx_expect))
 (enabled_if
  (and
   (<> %{env:CORALNPU_DATA=} "")
   %{lib-available:rivet.riscv32_encode}
   %{lib-available:rivet.driver_direct})))

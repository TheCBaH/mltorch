; The VME core suite's checks on MPACT (mpact-m4), bitwise and without cycles:
; its sources are the RTL suite's (derive.sh), so the two cannot drift, and the
; tests it tags "disabled" for the simulator's cost run here. Correctness only:
; MPACT has no timing model. Enabled by CORALNPU_DATA (make coralnpu.mpact.runtest).

(rule
 (target vme_test.ml)
 (deps derive.sh)
 (action
  (with-stdout-to
   %{target}
   (run sh derive.sh %{dep:../machine_rivet_riscv32_coral_vme/vme_test.ml}))))

(rule
 (target attention_layer_test.ml)
 (deps derive.sh)
 (action
  (with-stdout-to
   %{target}
   (run
    sh
    derive.sh
    %{dep:../machine_rivet_riscv32_coral_vme/attention_layer_test.ml}))))


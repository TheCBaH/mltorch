; The RV32 Machine IR suites of machine_rivet_riscv32_coral on MPACT: the RVV
; core's checks on mpact-m3 and the VME core's on mpact-m4, results only (derive.sh).

(rule
 (target rtl_test.ml)
 (deps ../derive.sh)
 (action
  (with-stdout-to
   %{target}
   (run sh ../derive.sh %{dep:../../machine_rivet_riscv32_coral/rtl_test.ml}))))


; The in-process embedding tests of test/loop_c_embed, copied rather than
; forked, with the RISC-V 32 loader in place of the gcc one: the model compiled
; by the embedded riscv32 CompCert, assembled by Rivet and run as an ELF under
; qemu-riscv32, reading and writing its region through a mapped file, is bitwise
; equal to the reference. Their committed expect output must hold unchanged.
; Built where both riscv32 embeddings are installed (the loader library holds
; both); qemu-riscv32 must be on the path.

(copy_files
 ../loop_c_embed/{embed_common,embed_test,embed_fp32_test,c_host_fixtures}.ml)

(library
 (name loop_c_embed_compcert_rv32_test)
 (libraries
  core
  err_trace
  fmt
  loop_c_embed
  loop_c_embed_compcert_rv32
  loop_c_exec
  loop_ir
  native
  native_test
  unix)
 (inline_tests)
 (preprocess
  (pps ppx_expect))
 (enabled_if
  (and
   %{lib-available:rivet_compcert.compcert_embed_riscv32}
   %{lib-available:rivet_compcert.compcert_embed_riscv32_fp32}
   %{lib-available:rivet.riscv32_encode})))

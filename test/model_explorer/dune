; The Model Explorer export suites. Under node as well as natively: this
; library exists for the 32-bit backend, so a native-only run would exercise
; the one width on which its aggregates cannot wrap. See test/native4d/dune for
; why [js] carries no `enabled_if`.

(library
 (name me_bytes_test)
 (modules me_bytes_test)
 (libraries core err_trace model_explorer_export)
 (inline_tests
  (modes best js))
 (preprocess
  (pps ppx_expect)))


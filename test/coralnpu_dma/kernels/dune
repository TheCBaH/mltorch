; The DMA suite's kernels as a library, so the Rivet-only byte baseline and the
; subsystem driver build the same modules.

(library
 (name dma_kernels)
 (wrapped false)
 (libraries
  coralnpu
  coralnpu_kernels
  coralnpu_kernels_zvt
  peak_kernels
  machine_rivet_riscv32
  rivet.asm_core
  rivet.riscv32_encode)
 (enabled_if
  (and
   %{lib-available:rivet.riscv32_encode}
   %{lib-available:rivet.driver_direct})))

; Raw transfer speed on the subsystem simulators: the DMA engine against the
; core's loads and stores (dma.t). CORALNPU_SUBSYSTEM_DATA names the extracted
; subsystem archive root, set by `make coralnpu.dma.runtest`.

(executable
 (name dma_bench)
 (modules dma_bench)
 (optional)
 (libraries
  coralnpu
  coralnpu_rv32
  dma_kernels
  peak_kernels
  err_trace
  fmt
  machine_rivet_riscv32))

(cram
 (applies_to
  dma
  gemm_rvv
  gemm_rvv_float
  gemm_zvt_normal
  gemm_zvt_i8
  gemm_zvt_f32
  gemm_resident_a
  gemm_row_major_a
  gemm_split_k)
 (deps %{exe:dma_bench.exe} (universe))
 (enabled_if
  (<> %{env:CORALNPU_SUBSYSTEM_DATA=} "")))

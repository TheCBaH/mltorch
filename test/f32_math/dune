; The binary32 transcendentals against the correctly rounded binary64 libm
; result, in units in the last place, over a stratified sample of the binary32
; line. The full 2^32 sweep is the [accuracy] executable.

(library
 (name f32_math_test)
 (modules f32_math_test)
 (libraries f32_math fmt)
 (inline_tests)
 (preprocess
  (pps ppx_expect)))

(executable
 (name accuracy)
 (modules accuracy)
 (libraries f32_math))

; [fma32] against an independent midpoint oracle, natively and under
; js_of_ocaml (the @runtest-js alias): the bits must not depend on the backend.

(library
 (name f32_fma_test)
 (modules fma32_test)
 (libraries f32_math fmt)
 (inline_tests
  (modes best js))
 (preprocess
  (pps ppx_expect)))

; [add_odd32] against exact integer arithmetic (zarith), native only.

(library
 (name f32_add_odd_test)
 (modules add_odd_test)
 (libraries f32_math fmt zarith)
 (inline_tests)
 (preprocess
  (pps ppx_expect)))

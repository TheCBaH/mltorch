; Verify JSON op-specs end-to-end (ATen vs native). Needs the C++ ATen build
; (via the bin exe) but no downloaded model weights.

(cram
 (applies_to aten_spec_verify_cram)
 (deps %{exe:../bin/aten_spec_verify.exe}))

; The Tensor[]-return path end to end: five hand-written unbind.int fixtures
; (one per (dim, out_rank) configuration the timm zoo records) through --eval.
; Hand-written rather than pt2_spec_gen'd — none of the PT2_MODELS_CRAM models
; contains unbind. Same gating as above: needs the C++ build, no weights.

(cram
 (applies_to unbind_spec_cram)
 (deps
  %{exe:../bin/aten_spec_verify.exe}
  (source_tree data/unbind)))

; Evaluate every per-node op-spec fixture derived from a real .pt2 model's
; exported graph (test/data/<model>/, generated by bin/pt2_spec_gen — see
; .ai/pt2_node_spec_design.md) through the real ATen kernel only. Fixtures are
; committed JSON, so — like aten_spec_verify_cram — this needs the C++ ATen
; build but no downloaded model weights. (source_tree) so new node files can
; be added later without touching this rule.

(cram
 (applies_to pt2_node_spec_cram)
 (deps
  %{exe:../bin/aten_spec_verify.exe}
  (source_tree data/resnet18)))

; Walk one fixture per distinct op (10 reseeded re-syntheses each, ATen-only)
; through --walk --eval. Same category as pt2_node_spec_cram above.

(cram
 (applies_to pt2_node_walk_cram)
 (deps
  %{exe:../bin/aten_spec_verify.exe}
  (source_tree data/resnet18)))

; ATen-vs-native compare (default aten_spec_verify mode) over the pt2

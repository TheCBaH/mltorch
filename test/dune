; Pure-OCaml pt2 reader: zip, strided tensor, pickle (no libtorch dependency).

; [opickle] is here for one reason: opickle's own test suite has no js mode, so
; a 32-bit-int regression added there could never be observed. Its Src module is
; re-exported publicly for exactly this ("unit-tested in isolation"), so the
; backend-sensitive assertion lives in this JS-enabled suite instead. The fix
; itself still belongs upstream. See .ai/js_backends_design.md.

(library
 (name pt2_test)
 (modules pt2_test)
 (libraries core err_trace pt2 zipc opickle bytesrw)
 ; See test/native4d/dune for why [js] carries no `enabled_if`.
 (inline_tests
  (modes best js))
 (preprocess
  (pps ppx_expect)))

; The five ordered archive checkpoints. Runs under node as well as natively
; because two of them turn on integer width: zipc's own [File.max_size] is
; [min Int.max_int 4294967295], which differs per backend, and the declared
; sizes are [int] (32-bit under js_of_ocaml) widened to [int64] before they meet
; a limit. A native-only suite could not see either.

(library
 (name pt2_zip_limits_test)
 (modules pt2_zip_limits_test)
 (libraries core err_trace pt2 zipc)
 (inline_tests
  (modes best js))
 (preprocess
  (pps ppx_expect)))


 (applies_to model_cram)
 (deps
  model_test_utils.ml
  schema_pytorch.ml
  schema_runtime.cma
  schema_runtime.cmi
  model.json))

; The Model Explorer export, over the committed resnet18 model.json. UNGATED:
; that file is a submodule checkout rather than a downloaded weight, so the
; whole lower/transform/project/validate path runs in every build. Its
; payload-free nature is the point -- it is the concrete Requires_payloads case.

(cram
 (applies_to me_visualize_json_cram)
 (deps %{exe:../bin/native_graph.exe} model.json))

; One kernel value's expression, over the committed resnet18 model.json.
; UNGATED for the same reason the session cram is.

(cram
 (applies_to me_detail_cram)
 (deps %{exe:../bin/native_graph.exe} model.json))

; The recoverable-failure shape, over graphs built in the cram itself. UNGATED,
; and hand-built on purpose: what it exercises is a graph the lowerer rejects,
; and no released model is one.

(cram
 (applies_to me_visualize_unsupported_cram)
 (deps %{exe:../bin/native_graph.exe}))

; Native lowering of a serialized Tensor[]-returning node. Same shape and same
; reason as the stanza above: hand-built, ungated, and driving the lowerer over
; node shapes no released model carries in a readable size.

(cram
 (applies_to unbind_native_cram)
 (deps %{exe:../bin/native_graph.exe}))

; The same export over a real .pt2. Gated on PT2_DATA, since it needs
; downloaded weights; it adds the archive path and the payload-dependent
; capabilities, which the committed model.json cannot reach.

(cram
 (applies_to me_visualize_cram)
 (deps (universe) %{exe:../bin/native_graph.exe})
 (enabled_if
  (<> %{env:PT2_DATA=} "")))


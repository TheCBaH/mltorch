; Tests for the real ATen / Native engine pair. They need the C++ ATen bridge
; and downloaded model data (PT2_DATA, as for `make pt2.runtest`).

(library
 (name pair_harness)
 (modules harness)
 (libraries
  inference_compare_test
  inference_compare_core
  inference_compare_extract
  inference_compare_policy
  inference_compare_metrics
  inference_compare_codecs
  err_trace
  fmt
  inference_compare_plan
  inference_compare_schema
  inference_compare_sha256
  unix))

(executable
 (name pair_run)
 (modules pair_run)
 (libraries
  pair_harness
  inference_compare_pt2
  inference_compare_test
  inference_compare_core
  inference_compare_extract
  inference_compare_policy
  inference_compare_metrics
  inference_compare_codecs
  pt2
  err_trace
  fmt
  inference_compare_plan
  inference_compare_schema
  inference_compare_compose
  inference_compare_sha256
  native
  native4d
  native_interp
  unix))

; Gated on PT2_DATA like the other real-archive crams (`make pt2.runtest`).

(cram
 (applies_to pair_cram)
 (deps (universe) %{exe:pair_run.exe})
 (enabled_if
  (<> %{env:PT2_DATA=} "")))

(cram
 (applies_to cli_cram)
 (deps (universe) %{exe:../../bin/inference_compare.exe})
 (enabled_if
  (<> %{env:PT2_DATA=} "")))

; Hermetic tests of the pass-map provider; no model data and no engine.

(library
 (name inference_compare_pt2_test)
 (modules pass_map_test)
 (libraries
  err_trace
  fmt
  inference_compare_codecs
  inference_compare_plan
  inference_compare_pt2
  inference_compare_schema
  inference_compare_sha256
  jsont.bytesrw
  native
  native4d
  native_test)
 (inline_tests)
 (preprocess
  (pps ppx_expect)))

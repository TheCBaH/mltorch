; A released Transformers fixture (not a .pt2) through the same pair and
; coordinator: ATen and Native on one case, unit by unit. A diagnostic driver;
; needs a populated fixture cache and Hub cache (make transformers.download).

(executable
 (name fixture_pair_run)
 (modules fixture_pair_run rivet_register compcert_register)
 (libraries
  (select
   rivet_register.ml
   from
   (inference_compare_rivet -> rivet_register.yes.ml)
   (-> rivet_register.no.ml))
  (select
   compcert_register.ml
   from
   (inference_compare_compiled -> compcert_register.yes.ml)
   (-> compcert_register.no.ml))
  model_source
  pt2_safetensors_unix
  pair_harness
  inference_compare_host
  inference_compare_generated
  inference_compare_js
  inference_compare_pt2
  inference_compare_codecs
  inference_compare_core
  inference_compare_extract
  inference_compare_schema
  inference_compare_sha256
  native
  pt2
  pt2_fixture
  pt2_fixture_unix
  err_trace
  fmt
  unix))

(executable
 (name fixture_linear_error)
 (modules fixture_linear_error)
 (libraries
  inference_compare_pt2
  inference_compare_schema
  inference_compare_sha256
  pt2
  pt2_fixture
  pt2_fixture_unix
  err_trace
  fmt))

; The Rivet AArch64 routes against the direct evaluator and each other on a
; real model; they run on the CPU, so they need an AArch64 host.

(cram
 (applies_to pair_rivet_cram)
 (deps (universe) %{exe:fixture_pair_run.exe})
 (enabled_if
  (and
   (<> %{env:PT2_DATA=} "")
   (= %{architecture} arm64)
   %{lib-available:rivet.aarch64_encode}
   %{lib-available:rivet.driver_direct})))

; The embedded CompCert as well, built only for MLTORCH_COMPCERT=<isa>.

(cram
 (applies_to pair_compcert_cram)
 (deps (universe) %{exe:fixture_pair_run.exe})
 (enabled_if
  (and
   (<> %{env:PT2_DATA=} "")
   (= %{env:MLTORCH_COMPCERT=none} aarch64)
   (= %{architecture} arm64)
   %{lib-available:rivet.aarch64_encode}
   %{lib-available:rivet.driver_direct})))

; The JavaScript engines on a real model, through the node helper. Needs node and
; the js_of_ocaml build of the helper, so it is gated on MLTORCH_JS and runs under
; `make js.compare.runtest`.

(cram
 (applies_to pair_js_cram)
 (deps
  (universe)
  %{exe:fixture_pair_run.exe}
  ../../js/jsoo/compare_js_engine/compare_js_engine.bc.js)
 (enabled_if
  (and
   (<> %{env:PT2_DATA=} "")
   (<> %{env:MLTORCH_JS=} ""))))

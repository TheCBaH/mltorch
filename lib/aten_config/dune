; Runtime op configuration — one record per curated ATen op, auto-generated
; from native_functions.yaml by bin/aten_ops_gen. No runtime dependency on the
; YAML parser or codegen libraries.

(rule
 (target aten_op_config.ml)
 (action
  (with-stdout-to
   %{target}
   (run
    %{exe:../../bin/aten_ops_gen.exe}
    %{dep:../../data/native_functions.yaml}
    aten_op_config.ml))))

(library
 (name aten_config)
 (wrapped false)
 (modules aten_op_config))

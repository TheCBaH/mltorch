; PT2 provenance sidecar for native graphs.  [bin/native_graph]'s print/eval
; commands use this through [native_interp]; keeping it separate from
; lib/native ensures generic graph execution never acquires PT2 names.

(library
 (name native_graph)
 (modules pt2_native_graph)
 (wrapped false)
 (libraries err_trace native pt2 pytorch_types schema_runtime))

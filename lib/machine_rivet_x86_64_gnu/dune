; The secondary route: the typed module Rivet encodes is printed as GNU source
; by Rivet's own printer, assembled and linked by the GNU toolchain at the
; addresses Rivet bound, and the two images compared byte for byte. Runs
; processes (as, ld, objcopy, nm), so it is apart from the pure mapping library.

(library
 (name machine_rivet_x86_64_gnu)
 (libraries
  fmt
  machine_rivet_x86_64
  rivet.x86_64
  rivet.asm_core
  rivet.image
  unix)
 (enabled_if %{lib-available:rivet.x86_64}))

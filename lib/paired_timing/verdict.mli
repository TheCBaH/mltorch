(** Recorded verdicts and the choice they support. The planner times nothing: it
    reads verdicts. A verdict certifies only the candidate that was measured,
    because the paired rule times a whole segment; its key is the target and
    backend, the numerics policy, the identity of the candidate and of the
    baseline, and the version of the implementation that generated both. A
    changed segment has a new key and is revalidated; until then the baseline is
    kept. *)

type key = {
  target : string;  (** target and backend *)
  numerics : string;  (** the numerics policy *)
  candidate : string;
      (** the candidate's identity: nodes, shapes, cover, realizations, layout
          and homes, schedule, packing *)
  baseline : string;  (** the baseline's identity, the same way *)
  version : string;  (** the implementation that generated both *)
}

type t = { key : key; report : Paired_timing.report }

(** Another stated reason that selects a candidate whatever its speed.
    Alphabetical. *)
type reason = Capacity | Code_size

(** Why the baseline stays. Alphabetical. *)
type kept =
  | Inconclusive_verdict
  | No_verdict
  | Output_differs
  | Regression of float  (** the median gain, negative *)

(** What a plan uses for one optional choice. Alphabetical. *)
type choice =
  | Accepted of float  (** the candidate, by the paired rule: the median gain *)
  | Candidate_for of reason * float option
      (** the candidate, for a reason other than speed, with the measured gain
          where a verdict exists, so a speed cost is reported beside it *)
  | Keep_baseline of kept

val choose : t list -> key -> ?reason:reason -> unit -> choice
(** The verdict whose key equals [key] exactly decides: accept selects the
    candidate; a differing output or no verdict keeps the baseline; a regression
    or an inconclusive verdict keeps it unless [reason] states another ground
    (an edge made [Scalar] for capacity is kept whatever its speed), which is
    then what the choice records, with the measured gain. A differing output is
    never overridden. *)

val current : t list -> version:string -> t list
(** The verdicts generated by [version]: a change of implementation version
    invalidates the others. *)

val covered : t list -> key list -> (unit, key) result
(** Whether every key has a verdict with exactly that key; the first without one
    is the error. A plan is marked accepted only if its optional choices are all
    covered. *)

val pp_choice : Format.formatter -> choice -> unit

; Whole-model bundles through Machine IR: each invocation's placed kernel is
; lowered to SSA by the bundle path's own producer, then to generic Machine IR,
; and run by the generic interpreter over storage that persists across a
; context's calls. Native only (it reads tensors' Bigarray storage). See the
; Machine IR design in .ai/.

(library
 (name machine_model)
 (libraries
  core
  err_trace
  fmt
  loop_ir
  machine_alloc
  machine_check
  machine_interp
  machine_ir
  machine_lower
  machine_target_aarch64
  machine_target_x86_64
  native
  ssa_backends
  ssa_ir))

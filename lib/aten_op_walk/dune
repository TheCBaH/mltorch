; Per-operation random-walk modules, auto-generated from native_functions.yaml
; (+ lib/aten_gen/walk_meta.ml) by bin/aten_ops_gen, same curated op list as
; aten_op_spec. Each module satisfies Aten_walk_recipes.Walk.Op; the runner that
; links ATen (native_walk) consumes them. No C++/ATen dependency here.

(rule
 (target aten_op_walk.ml)
 (action
  (with-stdout-to
   %{target}
   (run
    %{exe:../../bin/aten_ops_gen.exe}
    %{dep:../../data/native_functions.yaml}
    aten_op_walk.ml))))

(library
 (name aten_op_walk)
 (wrapped false)
 (modules aten_op_walk)
 (libraries aten_op_spec aten_spec aten_walk_recipes))

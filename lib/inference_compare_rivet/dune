; The Rivet AArch64 routes as engines for the comparison coordinator, and the
; variant words that select them: the image route (the bundle's Machine IR
; selected, assembled into an image of its own, regions copied in and out) and
; the table host (the same code called on the caller's own tensors). Built
; wherever Rivet's AArch64 libraries are installed, with or without CompCert;
; a host that is not AArch64 refuses at instantiation, naming the missing
; feature report, and no other route runs in its place.

(library
 (name inference_compare_rivet)
 (libraries
  err_trace
  fmt
  inference_compare_pt2
  inference_compare_schema
  loop_ir
  machine_model
  machine_rivet_aarch64
  native
  ssa_backends)
 (enabled_if
  (and
   %{lib-available:rivet.aarch64_encode}
   %{lib-available:rivet.driver_direct})))

; The Model Explorer export library. Pure OCaml, no Bigarray and no C stubs,
; so the whole of it is inside js_of_ocaml's closure — the browser shell
; compiles this same library rather than a second implementation of it.
;
; [(wrapped false)] because the three shells (the cmdliner CLI, the node
; golden, the browser bundle) refer to these modules by their [Me_*] names;
; the prefix is the namespace.

(library
 (name model_explorer_export)
 (wrapped false)
 (libraries
  core
  err_trace
  expr
  fmt
  bytesrw
  jsont
  jsont.bytesrw
  model_explorer
  native
  native4d
  native_graph
  native_interp
  pt2
  pytorch_types
  schema_runtime))

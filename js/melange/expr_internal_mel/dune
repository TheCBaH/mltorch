; Melange mirror of lib/expr_internal. Sources are copied, never forked, same
; rule as js/melange/core and js/melange/walk_core. See .ai/js_backends_design.md
; and expr-tailcall-implementation-plan.md under .ai/ (tail-call conversion,
; Stage 3). A separate library, rather than linking [expr_internal] directly,
; exists purely because cppo's [-D] set is scoped to the library stanza:
; [eval.ml]'s [value] is one source duplicated on both sides of an
; [#if defined JS_BACKEND], and this stanza is what selects the [#if] branch
; via its own preprocessing (MELANGE_BACKEND alongside JS_BACKEND), which the
; ordinary [expr_internal] stanza cannot also do with different flags.
;
; EXPLICIT file list, not a `*.ml`/`*.mli` wildcard glob: see
; js/jsoo/expr_internal_js/dune's comment for why -- the same dune quirk
; reproduces here, since both mirrors copy from the same dune-owned,
; cppo-preprocessed origin directory. Keep this list and expr_internal_js's
; in sync when a module is added to lib/expr_internal.
;
; Wrapped (dune's default), matching native's [expr_internal].

(copy_files
 (files
  %{workspace_root}/lib/expr_internal/{axis,bool,builder,checked,check,coord,eval_common,eval,eval_js_machine,expr_repr,fold,index,intrinsic,local_var,max_op,pp,reduce_var,reduction,rewrite,role,scalar,scan_admission,scan_limits,scan_meter,scan,source,value}.ml))

(copy_files
 (files
  %{workspace_root}/lib/expr_internal/{axis,coord,max_op,role,source}.mli))

; [eval_candidates.ml]/[eval_trampoline_delayed.ml]/[eval_machine_reuse.ml]/
; [eval_hybrid.ml] are not [lib/expr_internal] sources: they are the
; tail-call conversion's Stage 5 canonical JS-only candidate-driver modules
; (js/probe/ under .ai/), copied here (and into expr_internal_js) so they
; compile against real Expr_internal types. Never linked natively. Split
; across four files (rather than one combined [eval_candidates.ml]) once
; the combined file passed the repo's file-size cap.

(copy_files
 (files
  %{workspace_root}/js/probe/{eval_candidates,eval_trampoline_delayed,eval_machine_reuse,eval_hybrid}.ml))

(library
 (name expr_internal_mel)
 (modes melange)
 (enabled_if
  (= %{profile} melange))
 (libraries core_mel err_trace_mel fmt_mel)
 (preprocess
  (action
   (run %{bin:cppo} -D JS_BACKEND -D MELANGE_BACKEND %{input-file}))))

; The js_of_ocaml build of the probe.
;
; This directory mirrors nothing OF ITS OWN: only the three entry modules are
; copied, because a module must be owned by a stanza in the directory that
; builds it. But since the tail-call conversion's Stage 3, the eleven
; libraries reaching [Expr] (see .ai/ and js/jsoo/expr_internal_js/dune) are
; the mirrors declared alongside this directory (`native_js`, `native_interp_js`,
; etc.), not the ordinary [native]/[native_interp]/... -- so the JS evaluator
; these executables run is the one preprocessed with JS_BACKEND. Independent
; libraries ([probes_pure], [err_trace], [infer_report], [pt2]) stay ordinary:
; see the "Mirroring and namespaces" section of expr-tailcall-implementation-plan.md
; under .ai/ for which of the two lists a given dependency belongs to.
;
; Deliberately NOT `*.ml`: copying subset_probe.ml too would pull melange's
; entry point into this directory, where nothing builds it.
;
; No js_of_ocaml library dependency and no ppx: the probe only writes to stdout,
; so it needs the compiler, not the bindings.

(copy_files
 (files %{workspace_root}/js/probe/native_probe.ml))

(copy_files
 (files %{workspace_root}/js/probe/pt2_probe.ml))

(executable
 (name native_probe)
 (modes js)
 (modules native_probe)
 (libraries probes_pure probes_native_js probes_pt2_js))

; Tier 2. Same shape as above; separate stanzas with disjoint [modules] for the
; same reason js/probe/dune keeps them apart.

(executable
 (name pt2_probe)
 (modes js)
 (modules pt2_probe)
 (libraries probes_pt2_js))

; The all-sample inference runner (`make jsoo.pt2.run`), whose native half is in
; js/run. Same copy_files shape as the two probes above -- and note the
; libraries are declared HERE, independently: copy_files copies the .ml and
; nothing else, so js/run/dune's dependencies never reach this executable. A
; forbidden library has to be checked in both closures separately.

(copy_files
 (files %{workspace_root}/js/run/pt2_run.ml))

(executable
 (name pt2_run)
 (modes js)
 (modules pt2_run)
 (libraries err_trace infer_report native_interp_js native_predict_js pt2))

(library
 (name webapp_jsoo_buffer)
 (wrapped false)
 (modules webapp_jsoo_buffer)
 (libraries js_of_ocaml err_trace model_explorer_export))

(executable
 (name webapp_worker)
 (modes js)
 (modules webapp_worker)
 (libraries
  js_of_ocaml
  err_trace
  jsont
  jsont.bytesrw
  model_explorer_export
  webapp_jsoo_buffer))

; [native] is already linked through [model_explorer_export]; it is named here
; so the bridge can spell [Map_verify.Effort] when converting the browser's
; verification-effort option.

(executable
 (name webapp_bridge)
 (modes js)
 (modules webapp_bridge)
 (libraries
  js_of_ocaml
  err_trace
  jsont
  jsont.bytesrw
  model_explorer_export
  native
  webapp_jsoo_buffer))

; The lowering inspector's worker: the session worker's frame handling with the
; lowering view supplied, so it is the one worker that links [lowering_view]
; (and through it the C, WebAssembly, JavaScript and SSA emitters).

(executable
 (name lowering_worker)
 (modes js)
 (modules lowering_worker)
 (libraries
  core
  js_of_ocaml
  err_trace
  jsont
  jsont.bytesrw
  loop_ir
  lowering_key
  lowering_view
  model_explorer_export
  webapp_jsoo_buffer))

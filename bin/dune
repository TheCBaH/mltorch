; Driver for the ATen operation-binding generator (emits atg_ops.h / atg_ops.cpp /
; operation_description.ml; see lib/aten/dune for the rules that invoke it).

(executable
 (name aten_ops_gen)
 (modules aten_ops_gen)
 (libraries aten_gen aten_schema))

; CLI to verify JSON op-specs against the ATen-vs-native harness.
;
; Unconditionally links memtrace + landmarks (both self-gate on an env var at
; the top of aten_spec_verify.ml, see the comment there) — cheap either way,
; since neither library imposes real cost just by being linked and idle. The
; actual instrumentation cost (measured ~2.3x on the conv2d benchmark) is
; entirely in lib/native's `landmarks-ppx --auto` pass, which only happens
; under `dune build --profile landmarks` (see lib/native/dune and
; .ai/pt2_inference_perf.md's landmarks section) — this executable doesn't
; need its own profile split.

(executable
 (name aten_spec_verify)
 (modules aten_spec_verify)
 (libraries
  aten_op_spec
  aten_spec_run
  jsont
  jsont.bytesrw
  landmarks
  memtrace))

; CLI to derive per-node ATen op-spec JSON fixtures from a real .pt2 model
; graph. Pure OCaml, no ATen/libtorch build needed.

(executable
 (name pt2_spec_gen)
 (modules pt2_spec_gen)
 (libraries core err_trace pt2 pt2_spec_gen))

; CLI wrapper around the existing generated ATen-vs-native walk modules
; (lib/aten_op_walk, see .ai/native_walk_design.md) — same machinery
; test/native_walk_test.ml exercises inline, exposed here by target name for
; cram tests over a chosen op subset.

(executable
 (name native_walk_run)
 (modules native_walk_run)
 (libraries aten_op_walk aten_spec aten_spec_run aten_walk_recipes))

; General-purpose CLI for the native engine's graph representation (see
; lib/native_graph); cmdliner-based so more subcommands can land alongside
; `print` as the tool grows.  It is pure OCaml; PT2 tensor shapes are read
; directly by Native_interp, not through ATen.

(executable
 (name native_graph)
 (modules
  native_graph
  native_graph_common
  native_graph_args
  native_graph_print
  native_graph_eval
  native_graph_transform
  native_graph_to4d
  native_graph_const_ssa
  native_graph_visualize)
 (libraries
  cmdliner
  core
  err_trace
  err_host
  jsont
  jsont.bytesrw
  model_explorer
  model_explorer_export
  native
  native4d
  native_graph
  native_interp
  pt2
  pytorch_types
  unix))

